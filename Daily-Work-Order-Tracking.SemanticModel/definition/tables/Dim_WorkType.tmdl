	column Color
		dataType: string
		isHidden
		lineageTag: 1b0638f1-f2af-5d90-8a55-db0fffccd8e8
		summarizeBy: none
		sourceColumn: Color

		annotation SummarizationSetBy = User

	partition Dim_WorkType = m
		mode: import
		source =
				let
				    Palette = {"#E5402B", "#2368B5", "#B07F0C", "#7B48A8", "#13896A", "#A0561F", "#2B2F36",
				               "#9A9DA3", "#FF8A6B", "#7FA6D6", "#D9B25A", "#B4BCC4", "#163F73"},
				
				    Source = Table.SelectRows(OrdersStaging, each [Order Type] <> null),
				    // One row per code with its number of orders
				    Grouped = Table.Group(Source, {"Order Type"}, {{"_Orders", each Table.RowCount(_), Int64.Type}}),
				    Renamed = Table.RenameColumns(Grouped, {{"Order Type", "WorkTypeKey"}}),
				    Catalog = Table.Buffer(WorkTypeConfig),
				    WithCatalog = Table.ExpandTableColumn(
				        Table.NestedJoin(Renamed, {"WorkTypeKey"}, Catalog, {"WorkTypeKey"}, "C", JoinKind.LeftOuter),
				        "C", {"Work Type ES", "Work Type EN", "Target Business Days", "Is Site Visit"},
				        {"_NameES", "_NameEN", "Target Business Days", "_Visit"}),
				    WithNameES = Table.AddColumn(WithCatalog, "Work Type ES",
				        each if [_NameES] <> null then [_NameES]
				             else "Tipo sin catálogo (" & [WorkTypeKey] & ")", type text),
				    WithNameEN = Table.AddColumn(WithNameES, "Work Type EN",
				        each if [_NameEN] <> null then [_NameEN] else "Type not in catalog (" & [WorkTypeKey] & ")", type text),
				    WithVisit = Table.AddColumn(WithNameEN, "Is Site Visit", each [_Visit] = true, type logical),
				    Sorted = Table.Sort(WithVisit, {{"_Orders", Order.Descending}, {"WorkTypeKey", Order.Ascending}}),
				    WithOrder = Table.AddIndexColumn(Sorted, "Sort Order", 1, 1, Int64.Type),
				    WithColor = Table.AddColumn(WithOrder, "Color", each Palette{Number.Mod([Sort Order] - 1, List.Count(Palette))}, type text),
				    Final = Table.TransformColumnTypes(
				        Table.RemoveColumns(WithColor, {"_Orders", "_NameES", "_NameEN", "_Visit", "Sort Order"}),
				        {{"WorkTypeKey", type text}, {"Target Business Days", Int64.Type}})
				in
				    Final

	annotation PBI_ResultType = Table
