	column 'Work Type ES'
		dataType: string
		lineageTag: 73508c5d-19ea-5059-b452-dc8f5800149a
		summarizeBy: none
		sourceColumn: Work Type ES

		annotation SummarizationSetBy = User

	column 'Work Type EN'
		dataType: string
		lineageTag: 9e61db61-a758-5c3b-9f8f-471aa7c63e9d
		summarizeBy: none
		sourceColumn: Work Type EN

