	partition Dim_Request = m
		mode: import
		source =
				let
				    Source = Table.SelectRows(OrdersStaging, each [Request ID] <> null),
				    Grouped = Table.Group(Source, {"Request ID"}, {
				        {"Request Type ES", each List.First(List.RemoveNulls([Request Description ES]), "Sin tipo de solicitud"), type text},
				        {"Request Type EN", each List.First(List.RemoveNulls([Request Description EN]), "No request type"), type text},
				        {"Request Observation Lines ES", each fnWrapLines(List.First(List.RemoveNulls([Request Observation ES]), null), 82, 8), type nullable text},
				        {"Request Observation Lines EN", each fnWrapLines(List.First(List.RemoveNulls([Request Observation EN]), null), 82, 8), type nullable text}}),
				    Renamed = Table.RenameColumns(Grouped, {{"Request ID", "RequestKey"}}),
				    NoRequest = #table(
				        type table [RequestKey = Int64.Type, #"Request Type ES" = text, #"Request Type EN" = text,
				                    #"Request Observation Lines ES" = text, #"Request Observation Lines EN" = text],
				        {{-1, "Sin solicitud", "No request", null, null}}),
				    Combined = Table.Combine({Renamed, NoRequest}),
				    WithText = Table.AddColumn(Combined, "Request", each if [RequestKey] = -1 then "—" else Text.From([RequestKey]), type text),
				    Final = Table.TransformColumnTypes(WithText, {{"RequestKey", Int64.Type}})
				in
				    Final

	annotation PBI_ResultType = Table
