	column WorkTypeKey
		dataType: string
		isHidden
		lineageTag: 9a7f2fd3-d2fb-599f-9f18-03223769b5ca
		summarizeBy: none
		sourceColumn: WorkTypeKey

		annotation SummarizationSetBy = User

	partition Fact_Orders = m
		mode: import
		source =
				let
				    Cutoff = Date.From(SnapshotDate),
				    Cal = BusinessCalendar,
				    Keys = List.Transform(Cal[Date], each Date.ToText(_, [Format = "yyyy-MM-dd"])),
				    Index = Record.FromList(Cal[BusinessIndex], Keys),
				    IsBusiness = Record.FromList(Cal[IsBusinessDay], Keys),
				    BusinessDays = List.Buffer(Table.SelectRows(Cal, each [IsBusinessDay])[Date]),
				    fnIndex = (d as date) as number => Record.Field(Index, Date.ToText(d, [Format = "yyyy-MM-dd"])),
				    // Business days BEFORE the assignment: the clock starts on the assignment day (day 1)
				    fnBefore = (d as date) as number =>
				        fnIndex(d) - (if Record.Field(IsBusiness, Date.ToText(d, [Format = "yyyy-MM-dd"])) then 1 else 0),
				    CutoffIndex = fnIndex(Cutoff),
				
				    Types = Table.Buffer(Table.SelectColumns(Dim_WorkType, {"WorkTypeKey", "Target Business Days", "Is Site Visit"})),
				    ConsumptionBands = Table.Buffer(Table.SelectRows(Dim_ConsumptionBand, each [From Pct] <> null)),
				    AgeBands = Table.Buffer(Table.SelectRows(Dim_AgeBand, each [From Days] <> null)),
				    fnBand = (bands as table, value as number, fromCol as text, toCol as text, keyCol as text) as nullable number =>
				        let row = List.First(Table.ToRecords(Table.SelectRows(bands,
				                each value >= Record.Field(_, fromCol) and (Record.Field(_, toCol) = null or value <= Record.Field(_, toCol)))), null)
				        in if row = null then null else Record.Field(row, keyCol),
				
				    Joined = Table.NestedJoin(OrdersStaging, {"Order Type"}, Types, {"WorkTypeKey"}, "T", JoinKind.LeftOuter),
				    WithType = Table.ExpandTableColumn(Joined, "T", {"Target Business Days", "Is Site Visit"}),
				
				    WithDaysUsed = Table.AddColumn(WithType, "Business Days Used",
				        each if [Order Assigned At] = null then null
				             else List.Max({0, CutoffIndex - fnBefore([Order Assigned At])}), Int64.Type),
				    WithRemaining = Table.AddColumn(WithDaysUsed, "Days Remaining",
				        each if [Target Business Days] = null or [Business Days Used] = null then null
				             else [Target Business Days] - [Business Days Used], Int64.Type),
				    WithDueDate = Table.AddColumn(WithRemaining, "Due Date",
				        each if [Target Business Days] = null or [Order Assigned At] = null then null
				             else BusinessDays{fnBefore([Order Assigned At]) + [Target Business Days] - 1}, type date),
				    WithConsumption = Table.AddColumn(WithDueDate, "Target Consumption",
				        each if [Target Business Days] = null or [Target Business Days] = 0 or [Business Days Used] = null then null
				             else [Business Days Used] / [Target Business Days], type number),
				
				    WithTrafficLight = Table.AddColumn(WithConsumption, "_TrafficLight",
				        each if [Order Assigned At] = null then 0
				             else if [Target Business Days] = null then 4
				             else if [Days Remaining] < 0 then 3
				             else if [Days Remaining] <= 1 then 2
				             else 1, Int64.Type),
				    WithStatus = Table.AddColumn(WithTrafficLight, "SlaStatusKey",
				        each [_TrafficLight] * 10 + (if [Is Site Visit] = true then 1 else 0), Int64.Type),
				    WithConsumptionBand = Table.AddColumn(WithStatus, "ConsumptionBandKey",
				        each if [Target Consumption] = null then 5
				             else fnBand(ConsumptionBands, Number.RoundDown([Target Consumption] * 100), "From Pct", "To Pct", "ConsumptionBandKey"), Int64.Type),
				    WithAgeBand = Table.AddColumn(WithConsumptionBand, "AgeBandKey",
				        each if [Business Days Used] = null then 6
				             else fnBand(AgeBands, [Business Days Used], "From Days", "To Days", "AgeBandKey"), Int64.Type),
				
				    WithCustomer = Table.AddColumn(WithAgeBand, "CustomerKey", each fnCustomerKey([Customer Name]), type text),
				    fnNoAccents = (t as nullable text) as nullable text =>
				        if t = null then null
				        else Text.Lower(List.Accumulate(
				            {{"á", "a"}, {"é", "e"}, {"í", "i"}, {"ó", "o"}, {"ú", "u"}, {"ü", "u"},
				             {"Á", "a"}, {"É", "e"}, {"Í", "i"}, {"Ó", "o"}, {"Ú", "u"}, {"Ü", "u"}},
				            t, (s, p) => Text.Replace(s, p{0}, p{1}))),
				    WithSearch = Table.AddColumn(WithCustomer, "Search Text",
				        each Text.Combine(List.RemoveNulls({
				            Text.From([Order ID]),
				            if [Request ID] = null then null else Text.From([Request ID]),
				            [Customer Name],
				            fnNoAccents([Customer Name])
				        }), " | "), type text),
				
				    WithCommentES = Table.AddColumn(WithSearch, "Comment Lines ES",
				        each fnWrapLines([Order Comment ES], 82, 14), type nullable text),
				    WithCommentEN = Table.AddColumn(WithCommentES, "Comment Lines EN",
				        each fnWrapLines([Order Comment EN], 82, 14), type nullable text),
				
				    WithKeys = Table.TransformColumns(WithCommentEN, {
				        {"Request ID", each if _ = null then -1 else _, Int64.Type},
				        {"Location Code", each if _ = null then -1 else _, Int64.Type},
				        {"Work Unit Code", each if _ = null then -1 else _, Int64.Type}
				    }),
				    Renamed = Table.RenameColumns(WithKeys, {
				        {"Order ID", "Order Number"}, {"Request ID", "RequestKey"}, {"Order Type", "WorkTypeKey"},
				        {"Location Code", "LocationKey"},
				        {"Work Unit Code", "WorkUnitKey"},
				        {"Order Created At", "Created Date"}, {"Order Assigned At", "Assignment Date"}
				    }),
				    Final = Table.SelectColumns(Renamed, {
				        "Order Number", "RequestKey", "WorkTypeKey", "LocationKey",
				        "WorkUnitKey", "CustomerKey", "SlaStatusKey", "ConsumptionBandKey", "AgeBandKey",
				        "Created Date", "Assignment Date", "Due Date", "Target Business Days", "Business Days Used",
				        "Days Remaining", "Target Consumption", "Search Text", "Comment Lines ES", "Comment Lines EN"
				    }),
				    Typed = Table.TransformColumnTypes(Final, {
				        {"Order Number", Int64.Type}, {"WorkTypeKey", type text}, {"Created Date", type date},
				        {"Assignment Date", type date}, {"Target Business Days", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
