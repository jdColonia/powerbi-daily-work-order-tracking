	partition Dim_SlaStatus = m
		mode: import
		source =
				let
				    TrafficLight = #table(
				        type table [TrafficLightCode = Int64.Type, #"Status ES" = text, #"Status EN" = text, #"Status Order" = Int64.Type,
				                    GroupCode = Int64.Type, #"Card Group ES" = text, #"Card Group EN" = text, #"Group Order" = Int64.Type,
				                    Color = text, #"Text Color" = text, #"Background Color" = text],
				        {
				            {3, "Vencida",     "Overdue",    1, 3, "Vencidas",                          "Overdue", 1, "#C62828", "#C62828", "#FDE3DE"},
				            {2, "Por vencer",  "Due soon",   2, 2, "Por vencer",  "Due soon",   2, "#E3B341", "#B07F0C", "#FBF1D9"},
				            {1, "En tiempo",   "On time",    3, 1, "En tiempo",   "On time",    3, "#1A7F4B", "#1A7F4B", "#E4E4E0"},
				            {4, "Sin plazo",   "No target",  4, 4, "Sin plazo",   "No target",  4, "#9A9DA3", "#5F636A", "#F6F6F4"},
				            {0, "Sin asignar", "Unassigned", 5, 0, "Sin asignar", "Unassigned", 6, "#5F636A", "#5F636A", "#F6F6F4"}
				        }),
				    NotVisit = Table.AddColumn(TrafficLight, "Is Site Visit", each false, type logical),
				    Visit = Table.TransformColumns(
				        Table.AddColumn(TrafficLight, "Is Site Visit", each true, type logical),
				        {{"GroupCode", each 5, Int64.Type}, {"Card Group ES", each "Visitas a industria", type text},
				         {"Card Group EN", each "Industry visits", type text}, {"Group Order", each 5, Int64.Type}}),
				    All = Table.Combine({NotVisit, Visit}),
				    WithKey = Table.AddColumn(All, "SlaStatusKey",
				        each [TrafficLightCode] * 10 + (if [Is Site Visit] then 1 else 0), Int64.Type),
				    Final = Table.RemoveColumns(WithKey, {"Is Site Visit"})
				in
				    Final

	annotation PBI_ResultType = Table
