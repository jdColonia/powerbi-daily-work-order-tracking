            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\"$schema\":\"https://vega.github.io/schema/vega-lite/v5.json\",\"description\":\"Consumption of the response target: one row per band of Dim_ConsumptionBand; draws the stacked bar and the list with orders and share.\",\"data\":{\"name\":\"dataset\"},\"width\":700,\"height\":480,\"autosize\":{\"type\":\"none\"},\"padding\":0,\"config\":{\"view\":{\"stroke\":null},\"text\":{\"font\":\"Segoe UI\"}},\"transform\":[{\"calculate\":\"isValid(datum.OT) ? datum.OT : 0\",\"as\":\"ot\"},{\"joinaggregate\":[{\"op\":\"sum\",\"field\":\"ot\",\"as\":\"total\"}]},{\"calculate\":\"datum.total > 0 ? datum.ot / datum.total : 0\",\"as\":\"share\"},{\"window\":[{\"op\":\"sum\",\"field\":\"share\",\"as\":\"cum\"}],\"sort\":[{\"field\":\"Codigo\",\"order\":\"ascending\"}]},{\"calculate\":\"24 + 652 * (datum.cum - datum.share)\",\"as\":\"x0\"},{\"calculate\":\"24 + 652 * datum.cum - (datum.share > 0 ? 2 : 0)\",\"as\":\"x1\"},{\"calculate\":\"156 + (datum.Codigo - 1) * 62\",\"as\":\"y\"},{\"calculate\":\"datum.y + 6\",\"as\":\"yPunto\"},{\"calculate\":\"datum.y + 20\",\"as\":\"yPunto2\"},{\"calculate\":\"datum.y + 18\",\"as\":\"yRango\"},{\"calculate\":\"datum.y + 42\",\"as\":\"yDesc\"},{\"calculate\":\"datum.y + 54\",\"as\":\"yLinea\"},{\"calculate\":\"format(datum.share * 100, ''.0f'') + ''%''\",\"as\":\"pctTxt\"}],\"layer\":[{\"data\":{\"values\":[{}]},\"mark\":{\"type\":\"text\",\"align\":\"left\",\"baseline\":\"alphabetic\",\"fontSize\":24,\"fontWeight\":600,\"fill\":\"#0E1014\",\"text\":\"Plazo consumido\"},\"encoding\":{\"x\":{\"value\":24},\"y\":{\"value\":42}}},{\"data\":{\"values\":[{}]},\"mark\":{\"type\":\"text\",\"align\":\"left\",\"baseline\":\"alphabetic\",\"fontSize\":16,\"fill\":\"#5F636A\",\"text\":\"Qué parte del plazo ya usaron las órdenes abiertas (sin visitas a industria)\"},\"encoding\":{\"x\":{\"value\":24},\"y\":{\"value\":70}}},{\"transform\":[{\"filter\":\"datum.share > 0\"}],\"mark\":{\"type\":\"rect\",\"cornerRadius\":4},\"encoding\":{\"x\":{\"field\":\"x0\",\"type\":\"quantitative\",\"scale\":null},\"x2\":{\"field\":\"x1\"},\"y\":{\"value\":96},\"y2\":{\"value\":132},\"fill\":{\"field\":\"Color\",\"type\":\"nominal\",\"scale\":null}}},{\"mark\":{\"type\":\"rect\",\"cornerRadius\":3},\"encoding\":{\"x\":{\"value\":24},\"x2\":{\"value\":38},\"y\":{\"field\":\"yPunto\",\"type\":\"quantitative\",\"scale\":null},\"y2\":{\"field\":\"yPunto2\"},\"fill\":{\"field\":\"Color\",\"type\":\"nominal\",\"scale\":null}}},{\"mark\":{\"type\":\"text\",\"align\":\"left\",\"baseline\":\"alphabetic\",\"fontSize\":20,\"fontWeight\":600,\"fill\":\"#0E1014\"},\"encoding\":{\"x\":{\"value\":48},\"y\":{\"field\":\"yRango\",\"type\":\"quantitative\",\"scale\":null},\"text\":{\"field\":\"Rango\"}}},{\"mark\":{\"type\":\"text\",\"align\":\"left\",\"baseline\":\"alphabetic\",\"fontSize\":16,\"fill\":\"#5F636A\"},\"encoding\":{\"x\":{\"value\":48},\"y\":{\"field\":\"yDesc\",\"type\":\"quantitative\",\"scale\":null},\"text\":{\"field\":\"Descripcion\"}}},{\"mark\":{\"type\":\"text\",\"align\":\"right\",\"baseline\":\"alphabetic\",\"fontSize\":24,\"fontWeight\":600,\"fill\":\"#0E1014\"},\"encoding\":{\"x\":{\"value\":590},\"y\":{\"field\":\"yRango\",\"type\":\"quantitative\",\"scale\":null},\"text\":{\"field\":\"ot\"}}},{\"mark\":{\"type\":\"text\",\"align\":\"right\",\"baseline\":\"alphabetic\",\"fontSize\":16,\"fill\":\"#5F636A\"},\"encoding\":{\"x\":{\"value\":676},\"y\":{\"field\":\"yRango\",\"type\":\"quantitative\",\"scale\":null},\"text\":{\"field\":\"pctTxt\"}}},{\"transform\":[{\"filter\":\"datum.Codigo < 5\"}],\"mark\":{\"type\":\"rule\",\"stroke\":\"#E4E4E0\",\"strokeWidth\":1},\"encoding\":{\"x\":{\"value\":24},\"x2\":{\"value\":676},\"y\":{\"field\":\"yLinea\",\"type\":\"quantitative\",\"scale\":null}}}]}'"
